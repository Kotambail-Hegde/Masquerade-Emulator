    "title": "H8",
    "release": "2017",
    "authors": ["Mastigophoran"],
    "roms": {
      "3ee8a64a9af37a8d24aab9e73410b94cc0a4018f": {
        "file": "H8 (by Mastigophoran)(2017).sc8",
        "platforms": ["superchip"]
      }
    }
