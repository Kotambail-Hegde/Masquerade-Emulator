        "file": "Hidden (fix)[David Winter, 1996].ch8",
        "platforms": ["originalChip8", "modernChip8"],
        "embeddedTitle": "HIDDEN! 1.0 By David WINTER",
        "keys": {
          "up": 2,
          "left": 4,
